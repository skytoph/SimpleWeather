<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MediumValue">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?titleTextColor</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="MediumSubtitle">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textColor">?subtitleTextColor</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Warning">
        <item name="android:textColor">@color/yellow</item>
    </style>

    <style name="WarningSmall" parent="Warning">
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WarningTitle" parent="Warning">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WarningDescription">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?contentTextColor</item>
    </style>

    <style name="SmallContent">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">?contentTextColor</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="HighlightedValue">
        <item name="fontFamily">@font/poppins</item>
        <item name="android:textColor">?attr/highlightedTextColor</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="HighlightedCapsValue" parent="HighlightedValue">
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="MediumTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/mainTitleTextColor</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextGraySubtitleTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?subtitleTextColor</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="ActionButtonSave">
        <item name="backgroundColorDisabled">@color/green</item>
        <item name="backgroundColorEnabled">?mainViewsBackground</item>
        <item name="contentColorDisabled">@color/white</item>
        <item name="contentColorEnabled">?highlightedTextColor</item>
        <item name="iconDisabled">@drawable/ic_done</item>
        <item name="iconEnabled">@drawable/ic_add_circle_outline</item>
    </style>

    <style name="EditTextSearch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/rectangle_rounded_15</item>
        <item name="android:textColorHint">?titleTextColor</item>
        <item name="android:textColor">?attr/mainTitleTextColor</item>
        <item name="android:drawableEnd">@drawable/ic_search</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColorHint">?titleTextColor</item>
        <item name="android:textColor">?attr/mainTitleTextColor</item>
        <item name="searchIcon">@drawable/ic_search</item>
        <item name="searchHintIcon">@drawable/ic_search</item>
        <item name="closeIcon">@drawable/ic_close</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Degrees">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?attr/mainTitleTextColor</item>
        <item name="android:textSize">70sp</item>
    </style>

    <style name="Location">
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">?attr/mainTitleTextColor</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="ErrorMessageView">
        <item name="android:drawableBottom">@drawable/ic_clouds_gray</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="PlaceholderGray">
        <item name="android:backgroundTint">?attr/placeholderColor</item>
        <item name="android:background">@drawable/rectangle_rounded_11</item>
    </style>

    <style name="Attribution">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical|end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:textColor">?highlightedTextColor</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ToolbarTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">?attr/mainTitleTextColor</item>
    </style>

    <style name="About" />

    <style name="About.Title" parent="About">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/mainTitleTextColor</item>
    </style>

    <style name="About.Description" parent="About">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?mainTitleTextColor</item>
    </style>

    <style name="About.Hyperlink" parent="About.Description">
        <item name="android:textColor">?colorSecondary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="LoadingShimmer">
        <item name="shimmer_auto_start">false</item>
        <item name="shimmer_duration">2000</item>
        <item name="shimmer_fixed_height">320dp</item>
        <item name="shimmer_base_alpha">0.6</item>
    </style>
</resources>