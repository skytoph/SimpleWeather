<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--    Views color-->
    <attr name="mainViewsBackground" format="color" />

    <!--    Tabs color-->
    <attr name="tabDotColor" format="color" />
    <attr name="tabDotSelectedColor" format="color" />

    <!--    Text color-->
    <attr name="mainTitleTextColor" format="color" />
    <attr name="highlightedTextColor" format="color" />
    <attr name="contentTextColor" format="color" />

    <attr name="googleLogo" format="reference" />

    <attr name="weatherProviderLogo" format="reference" />

    <declare-styleable name="HorizonView">
        <attr name="sunrise_time" format="string" />
        <attr name="sunset_time" format="string" />
        <attr name="fontFamily" format="string" />
        <attr name="t" format="float" />
        <attr name="titleColor" format="reference|color" />
        <attr name="valueColor" format="reference|color" />
    </declare-styleable>

    <declare-styleable name="ActionButton">
        <attr name="iconEnabled" format="reference" />
        <attr name="iconDisabled" format="reference" />
        <attr name="backgroundColorEnabled" format="reference|color" />
        <attr name="backgroundColorDisabled" format="reference|color" />
        <attr name="contentColorEnabled" format="reference|color" />
        <attr name="contentColorDisabled" format="reference|color" />
        <attr name="textEnabled" format="string" />
        <attr name="textDisabled" format="string" />
    </declare-styleable>

    <declare-styleable name="ClickableLinkView">
        <attr name="url" format="string" />
    </declare-styleable>
</resources>