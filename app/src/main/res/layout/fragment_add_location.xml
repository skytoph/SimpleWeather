<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".presentation.addlocation.AddLocationFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/appbar_add_location"
            layout="@layout/appbar_with_title" />

        <com.github.skytoph.simpleweather.core.presentation.view.ActionButton
            android:id="@+id/message_button"
            style="@style/ActionButtonSave"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_marginEnd="24dp"
            android:visibility="invisible"
            app:textDisabled="@string/action_added_to_list"
            app:textEnabled="@string/action_add_to_list"
            tools:visibility="visible" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/error_view"
                style="@style/ErrorMessageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="20dp"
                android:text="@string/error_general"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/weather_add_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="41dp" />

            <include
                android:id="@+id/placeholder"
                layout="@layout/placeholder_weather" />
        </FrameLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>